# Post-rerank fusion disabled (RUN_RRF_FUSION=0). BM25+Dense+RetrievalFusion+Rerank
# all run, but document-route evidence falls back to the raw cross-encoder runs
# instead of the Retrieval+Rerank RRF fusion. Guards that fallback path.
REPO_ROOT=/work

WORKFLOW_OUTPUT_DIR=/work/demo/output_norrf

TRAIN_JSON=/work/demo/data/queries.jsonl

TOP_K=100
RECALL_KS=10,50,100

BM25_INDEX_PATH=/work/demo/indexes/bm25_chunked
DENSE_INDEX_DIR=/work/demo/indexes/dense_chunked

BM25_THREADS=2
BM25_SAVE_RUNS=1

DENSE_DEVICE=cpu
DENSE_BATCH_SIZE=32

HYBRID_MODE=default
HYBRID_JOBS=2

RUN_RRF_FUSION=0

DOCS_JSONL=/work/demo/data/docs_chunked.jsonl
RERANK_CANDIDATE_LIMIT=50
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_MODEL_DEVICE=cpu
RERANK_MODEL_BATCH=16
RERANK_MODEL_MAX_LENGTH=512

RUN_DOCUMENT=1
RUN_SNIPPET_RRF=0
RUN_GENERATION_DOCUMENT=0
RUN_GENERATION_SNIPPET=0
