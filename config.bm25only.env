# Single-retriever first stage: BM25 only, no Dense, no retrieval fusion.
# Exercises STAGE1_SOURCE=bm25 -> the BM25 run is staged as the canonical
# stage1_<split>_top<k>.tsv that rerank/evidence consume (skip Dense + Fusion).
REPO_ROOT=/work

WORKFLOW_OUTPUT_DIR=/work/demo/output_bm25only

TRAIN_JSON=/work/demo/data/queries.jsonl

TOP_K=100
RECALL_KS=10,50,100

STAGE1_SOURCE=bm25
BM25_INDEX_PATH=/work/demo/indexes/bm25_chunked

BM25_THREADS=2
BM25_SAVE_RUNS=1

DOCS_JSONL=/work/demo/data/docs_chunked.jsonl
RERANK_CANDIDATE_LIMIT=50
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RERANK_MODEL_DEVICE=cpu
RERANK_MODEL_BATCH=16
RERANK_MODEL_MAX_LENGTH=512

RUN_DOCUMENT=1
RUN_SNIPPET_RRF=0
RUN_GENERATION_DOCUMENT=0
RUN_GENERATION_SNIPPET=0
